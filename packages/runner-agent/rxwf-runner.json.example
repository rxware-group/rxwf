{
  "serverUrl": "https://rxwf.example.com",
  "runnerId": "uuid",
  "credentialFile": "/etc/rxwf-runner/credential",
  "name": "win-build-01",
  "maxConcurrent": 4,
  "extensions": [
    "@rxwf/runner-builtin-plus",
