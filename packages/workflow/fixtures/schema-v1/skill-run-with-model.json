{
  "schemaVersion": 1,
  "name": "Skill Run With Model",
  "nodes": [
    {
      "id": "t1",
      "type": "manualTrigger",
      "name": "Start",
      "position": { "x": 0, "y": 0 },
      "parameters": {}
    },
    {
      "id": "s1",
      "type": "skillRun",
      "name": "Run Skill",
      "position": { "x": 220, "y": 0 },
      "parameters": {
        "skillSource": "path",
        "skillPath": "demo-skill"
      }
    },
    {
      "id": "model-1",
      "type": "aiChatModel",
      "name": "Chat Model",
      "position": { "x": 220, "y": 120 },
      "parameters": {
        "provider": "ollama",
        "model": "llama3"
      }
    }
  ],
  "connections": [
    { "from": "t1", "to": "s1" },
    { "from": "model-1", "to": "s1", "toInput": "ai_languageModel" }
  ]
}
